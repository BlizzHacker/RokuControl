{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Roku Control",
  "version": "2.0.0",
  "identifier": "com.moveweight.roku-control",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Roku Control",
        "width": 420,
        "height": 750,
        "minWidth": 360,
        "minHeight": 550,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      },
      {
        "label": "widget",
        "title": "Roku Widget",
        "width": 260,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "/#/widget"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Roku Control",
      "menuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self'; connect-src http://192.168.*:* http://10.*:* http://172.16.*:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
